<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is copied by cloud backup or by device-to-device transfer: the settings hold encrypted Internet Archive
  credentials whose key never leaves this device, and folder permissions cannot move to another device anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
