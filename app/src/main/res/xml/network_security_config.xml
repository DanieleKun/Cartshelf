<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: https only, and only the certificate authorities that ship with Android (no user-installed ones). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
